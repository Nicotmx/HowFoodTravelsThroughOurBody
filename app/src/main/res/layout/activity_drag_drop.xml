<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF4D6"
    android:scrollbars="vertical"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag &amp; Drop Challenge"
            android:textColor="#FF7A00"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Can you arrange the digestive organs in the correct order?"
            android:textColor="#555555"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arrange all 5 organs to complete the challenge!"
            android:textColor="#555555"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drag these organs:"
            android:textColor="#FF7A00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <GridLayout
            android:id="@+id/organContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="180dp"
            android:columnCount="2"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drop them in order:"
            android:textColor="#FF7A00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/slot1"
            style="@style/DropSlotStyle">
            <TextView style="@style/DropSlotText" android:text="1. First Organ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot2"
            style="@style/DropSlotStyle">
            <TextView style="@style/DropSlotText" android:text="2. Second Organ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot3"
            style="@style/DropSlotStyle">
            <TextView style="@style/DropSlotText" android:text="3. Third Organ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot4"
            style="@style/DropSlotStyle">
            <TextView style="@style/DropSlotText" android:text="4. Fourth Organ" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/slot5"
            style="@style/DropSlotStyle">
            <TextView style="@style/DropSlotText" android:text="5. Fifth Organ" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Check Answer"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Reset"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFC107"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Back"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>